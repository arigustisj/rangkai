#!/usr/bin/env bash
# Rangkai Install Script - Generated for {{.ProfileName}}
# Run this after rangkai init to complete the setup

set -euo pipefail

PROFILE_NAME="{{.ProfileName}}"
STACK="{{.Stack}}"
MODEL="{{.Model}}"
HOME_DIR="{{.HomeDir}}"
HERMES_DIR="${HOME_DIR}/.hermes/profiles/${PROFILE_NAME}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

main() {
    log_info "Starting Rangkai installation for profile: ${PROFILE_NAME}"
    log_info "Stack: ${STACK} | Model: ${MODEL}"

    # 1. Check prerequisites
    check_prerequisites

    # 2. Install Hermes if not present
    install_hermes

    # 3. Create profile directory structure
    create_profile_structure

    # 4. Generate config.yaml
    generate_config

    # 5. Install core skills
    install_skills

    # 6. Setup MCP servers
    setup_mcp

    # 7. Install hooks
    install_hooks

    # 8. Verify installation
    run_verify

    log_info "✅ Installation complete!"
    log_info "Profile location: ${HERMES_DIR}"
    log_info "Next steps:"
    log_info "  1. cd ${HERMES_DIR}"
    log_info "  2. cp .env.example .env  # Add your API tokens"
    log_info "  3. hermes --profile ${PROFILE_NAME} \"hello world\""
}

check_prerequisites() {
    log_info "Checking prerequisites..."

    local missing=()

    command -v go >/dev/null 2>&1 || missing+=("go")
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v docker >/dev/null 2>&1 || missing+=("docker")
    command -v curl >/dev/null 2>&1 || missing+=("curl")

    if [ ${#missing[@]} -ne 0 ]; then
        log_error "Missing required tools: ${missing[*]}"
        log_error "Please install them first."
        exit 1
    fi

    log_info "All prerequisites satisfied"
}

install_hermes() {
    log_info "Checking Hermes installation..."

    if command -v hermes >/dev/null 2>&1; then
        log_info "Hermes already installed: $(hermes --version)"
        return
    fi

    log_info "Installing Hermes..."
    # Install via official method (adjust as needed)
    curl -fsSL https://get.hermes-agent.com | bash

    # Add to PATH if needed
    export PATH="${HOME}/.hermes/bin:${PATH}"

    if command -v hermes >/dev/null 2>&1; then
        log_info "Hermes installed: $(hermes --version)"
    else
        log_error "Hermes installation failed"
        exit 1
    fi
}

create_profile_structure() {
    log_info "Creating profile directory structure..."

    mkdir -p "${HERMES_DIR}"/{data,cache,memory,skills,plugins,cron,scripts}
    mkdir -p "${HERMES_DIR}/data"/{kanban,sessions,swarm}

    log_info "Directory structure created at ${HERMES_DIR}"
}

generate_config() {
    log_info "Generating config.yaml..."

    # Config is already generated by rangkai init, just verify
    if [ -f "${HERMES_DIR}/config.yaml" ]; then
        log_info "config.yaml already exists"
    else
        log_warn "config.yaml not found - run 'rangkai init' first"
    fi
}

install_skills() {
    log_info "Installing skills..."

    # Core skills (from Hermes default or local)
    local core_skills=("orchestrator" "ponytail" "executive-agent-mode" "antislop")

    for skill in "${core_skills[@]}"; do
        if [ -d "${HOME_DIR}/.hermes/skills/${skill}" ]; then
            ln -sf "${HOME_DIR}/.hermes/skills/${skill}" "${HERMES_DIR}/skills/${skill}"
            log_info "Linked core skill: ${skill}"
        else
            log_warn "Core skill not found: ${skill} (will load from Hermes default)"
        fi
    done

    # Stack-specific skills
    case "${STACK}" in
        go)
            local stack_skills=("go-railway-backend" "go-http-service-performance")
            ;;
        node)
            local stack_skills=("setup-ts-deep-modules")
            ;;
        laravel)
            local stack_skills=()
            ;;
        python)
            local stack_skills=()
            ;;
        *)
            local stack_skills=()
            ;;
    esac

    for skill in "${stack_skills[@]}"; do
        if [ -d "${HOME_DIR}/.hermes/skills/${skill}" ]; then
            ln -sf "${HOME_DIR}/.hermes/skills/${skill}" "${HERMES_DIR}/skills/${skill}"
            log_info "Linked stack skill: ${skill}"
        fi
    done

    # Project skills (clone from rangkai-skills repo if available)
    if [ -n "${RANGKAI_SKILLS_REPO:-}" ]; then
        log_info "Cloning shared skills from ${RANGKAI_SKILLS_REPO}..."
        git clone "${RANGKAI_SKILLS_REPO}" "${HERMES_DIR}/skills/shared" 2>/dev/null || \
            log_warn "Could not clone shared skills (repo may not exist or no access)"
    fi
}

setup_mcp() {
    log_info "Setting up MCP servers..."

    # Create .env.example if not exists
    if [ ! -f "${HERMES_DIR}/.env.example" ]; then
        cat > "${HERMES_DIR}/.env.example" << 'EOF'
# GitHub
GITHUB_TOKEN=ghp_xxx

# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=xxx

# Postgres
POSTGRES_DSN=postgres://user:pass@host:5432/db?sslmode=disable

# Cloudflare
CF_API_TOKEN=xxx
CF_ACCOUNT_ID=xxx

# Doris
DORIS_URL=http://host:8030
DORIS_USER=root
DORIS_PASSWORD=xxx

# N8N
N8N_URL=https://n8n.yourdomain.com
N8N_API_KEY=xxx

# SSH (uses ~/.ssh/config)
EOF
        log_info "Created .env.example - copy to .env and fill in your credentials"
    fi
}

install_hooks() {
    log_info "Installing git hooks..."

    cat > "${HERMES_DIR}/scripts/pre-commit" << 'EOF'
#!/usr/bin/env bash
# Pre-commit hook - generated by Rangkai

set -e

# Go formatting
if command -v go >/dev/null 2>&1; then
    go fmt ./...
    go vet ./...
fi

# Linting
if command -v golangci-lint >/dev/null 2>&1; then
    golangci-lint run
fi

# Tests
if command -v go >/dev/null 2>&1; then
    go test ./...
fi
EOF
    chmod +x "${HERMES_DIR}/scripts/pre-commit"

    cat > "${HERMES_DIR}/scripts/pre-push" << 'EOF'
#!/usr/bin/env bash
# Pre-push hook - generated by Rangkai

set -e

# Build check
if command -v go >/dev/null 2>&1; then
    go build ./...
    go test ./...
fi
EOF
    chmod +x "${HERMES_DIR}/scripts/pre-push"

    # Setup git hooks if in a git repo
    if [ -d ".git" ]; then
        ln -sf "${HERMES_DIR}/scripts/pre-commit" .git/hooks/pre-commit
        ln -sf "${HERMES_DIR}/scripts/pre-push" .git/hooks/pre-push
        log_info "Git hooks installed"
    fi
}

run_verify() {
    log_info "Running verification..."

    if [ -f "${HERMES_DIR}/verify.sh" ]; then
        bash "${HERMES_DIR}/verify.sh"
    else
        log_warn "verify.sh not found - run 'rangkai verify' after setup"
    fi
}

main "$@"