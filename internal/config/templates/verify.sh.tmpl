#!/usr/bin/env bash
# Rangkai Verify Script - Health checks for {{.ProfileName}}
# Run this to verify the environment is properly configured

set -euo pipefail

PROFILE_NAME="{{.ProfileName}}"
HOME_DIR="{{.HomeDir}}"
HERMES_DIR="${HOME_DIR}/.hermes/profiles/${PROFILE_NAME}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

PASS=0
FAIL=0
WARN=0

log_pass() { echo -e "${GREEN}[PASS]${NC} $*"; PASS=$((PASS+1)); }
log_fail() { echo -e "${RED}[FAIL]${NC} $*"; FAIL=$((FAIL+1)); }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; WARN=$((WARN+1)); }
log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }

check_hermes() {
    log_info "Checking Hermes installation..."

    if command -v hermes >/dev/null 2>&1; then
        local version=$(hermes --version 2>/dev/null || echo "unknown")
        log_pass "Hermes found: ${version}"
    else
        log_fail "Hermes not in PATH"
        return 1
    fi

    # Check hermes doctor
    if hermes doctor --profile "${PROFILE_NAME}" >/dev/null 2>&1; then
        log_pass "hermes doctor: clean"
    else
        log_warn "hermes doctor: issues found (run 'hermes doctor' for details)"
    fi
}

check_config() {
    log_info "Checking configuration..."

    if [ -f "${HERMES_DIR}/config.yaml" ]; then
        log_pass "config.yaml exists"

        # Validate YAML syntax
        if command -v yq >/dev/null 2>&1; then
            if yq eval '.' "${HERMES_DIR}/config.yaml" >/dev/null 2>&1; then
                log_pass "config.yaml: valid YAML"
            else
                log_fail "config.yaml: invalid YAML syntax"
            fi
        fi

        # Check required sections
        local required=("model" "tools" "skills" "mcp" "profile" "servers" "hooks")
        for section in "${required[@]}"; do
            if grep -q "^${section}:" "${HERMES_DIR}/config.yaml"; then
                log_pass "config.yaml: has '${section}' section"
            else
                log_warn "config.yaml: missing '${section}' section"
            fi
        done
    else
        log_fail "config.yaml not found at ${HERMES_DIR}/config.yaml"
    fi
}

check_skills() {
    log_info "Checking skills..."

    local core_skills=("orchestrator" "ponytail" "executive-agent-mode" "antislop")
    local missing=0

    for skill in "${core_skills[@]}"; do
        if [ -d "${HERMES_DIR}/skills/${skill}" ] || [ -d "${HOME_DIR}/.hermes/skills/${skill}" ]; then
            log_pass "Skill loaded: ${skill}"
        else
            log_fail "Skill missing: ${skill}"
            ((missing++))
        fi
    done

    # Check stack skills
    case "{{.Stack}}" in
        go)
            local stack_skills=("go-railway-backend" "go-http-service-performance")
            ;;
        node)
            local stack_skills=("setup-ts-deep-modules")
            ;;
        *)
            local stack_skills=()
            ;;
    esac

    for skill in "${stack_skills[@]}"; do
        if [ -d "${HERMES_DIR}/skills/${skill}" ] || [ -d "${HOME_DIR}/.hermes/skills/${skill}" ]; then
            log_pass "Stack skill loaded: ${skill}"
        else
            log_warn "Stack skill not found: ${skill} (optional)"
        fi
    done

    if [ $missing -eq 0 ]; then
        log_pass "All core skills present"
    fi
}

check_model() {
    log_info "Checking model connectivity..."

    # This would need actual Hermes API call
    # For now, just check config has model configured
    if grep -q "provider:" "${HERMES_DIR}/config.yaml" 2>/dev/null; then
        local model=$(grep "provider:" "${HERMES_DIR}/config.yaml" | head -1 | sed 's/.*provider: *"\([^"]*\)".*/\1/')
        log_pass "Model configured: ${model}"
    else
        log_warn "Model provider not found in config"
    fi
}

check_mcp() {
    log_info "Checking MCP servers..."

    local mcp_servers=("github" "jira" "postgres" "cloudflare" "doris" "n8n" "ssh")

    for server in "${mcp_servers[@]}"; do
        if grep -q "${server}:" "${HERMES_DIR}/config.yaml" 2>/dev/null; then
            log_pass "MCP configured: ${server}"
        else
            log_warn "MCP not configured: ${server}"
        fi
    done

    # Check .env exists
    if [ -f "${HERMES_DIR}/.env" ]; then
        log_pass ".env file exists"
    else
        log_warn ".env file not found (copy from .env.example and fill credentials)"
    fi
}

check_hooks() {
    log_info "Checking git hooks..."

    if [ -f "${HERMES_DIR}/scripts/pre-commit" ] && [ -x "${HERMES_DIR}/scripts/pre-commit" ]; then
        log_pass "pre-commit hook exists and executable"
    else
        log_warn "pre-commit hook missing or not executable"
    fi

    if [ -f "${HERMES_DIR}/scripts/pre-push" ] && [ -x "${HERMES_DIR}/scripts/pre-push" ]; then
        log_pass "pre-push hook exists and executable"
    else
        log_warn "pre-push hook missing or not executable"
    fi

    # Check if linked in git repo
    if [ -d ".git" ]; then
        if [ -L ".git/hooks/pre-commit" ]; then
            log_pass "pre-commit linked in .git/hooks"
        else
            log_warn "pre-commit not linked in .git/hooks"
        fi
    fi
}

check_profile_structure() {
    log_info "Checking profile directory structure..."

    local dirs=("data" "cache" "memory" "skills" "plugins" "cron" "scripts")
    for dir in "${dirs[@]}"; do
        if [ -d "${HERMES_DIR}/${dir}" ]; then
            log_pass "Directory exists: ${dir}"
        else
            log_fail "Directory missing: ${dir}"
        fi
    done
}

check_git_config() {
    log_info "Checking git configuration..."

    local name=$(git config --global user.name 2>/dev/null || echo "")
    local email=$(git config --global user.email 2>/dev/null || echo "")

    if [ -n "${name}" ]; then
        log_pass "git user.name: ${name}"
    else
        log_warn "git user.name not set globally"
    fi

    if [ -n "${email}" ]; then
        log_pass "git user.email: ${email}"
    else
        log_warn "git user.email not set globally"
    fi
}

check_tools() {
    log_info "Checking development tools..."

    local tools=("go" "git" "docker" "curl" "jq" "yq" "golangci-lint")
    for tool in "${tools[@]}"; do
        if command -v "${tool}" >/dev/null 2>&1; then
            log_pass "Tool available: ${tool}"
        else
            log_warn "Tool not found: ${tool}"
        fi
    done
}

main() {
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║          Rangkai Environment Verification                ║"
    echo "║          Profile: ${PROFILE_NAME}$(printf '%*s' $((37 - ${#PROFILE_NAME})) '')║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo

    check_profile_structure
    echo
    check_config
    echo
    check_hermes
    echo
    check_skills
    echo
    check_model
    echo
    check_mcp
    echo
    check_hooks
    echo
    check_git_config
    echo
    check_tools
    echo

    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                      SUMMARY                              ║"
    echo "╠══════════════════════════════════════════════════════════╣"
    printf "║  ${GREEN}PASS${NC}: %-3d  ${YELLOW}WARN${NC}: %-3d  ${RED}FAIL${NC}: %-3d                        ║\n" $PASS $WARN $FAIL
    echo "╚══════════════════════════════════════════════════════════╝"

    if [ $FAIL -eq 0 ]; then
        echo -e "\n${GREEN}✅ All critical checks passed! Environment is ready.${NC}"
        exit 0
    else
        echo -e "\n${RED}❌ ${FAIL} critical check(s) failed. Fix them before using.${NC}"
        exit 1
    fi
}

main "$@"