# Hermes Configuration - Generated by Rangkai
# Profile: {{.ProfileName}}
# Stack: {{.Stack}}
# Model: {{.Model}}

version: "1.0"

# ──────────────────────────────────────────────
# Model Configuration
# ──────────────────────────────────────────────
model:
  provider: "{{.Model}}"
  # Fallback chain (optional)
  # fallback:
  #   - provider: "ollama:llama3.1:8b"
  #   - provider: "openrouter:nvidia/nemotron-3-ultra"

# Context budget (tokens) — adjust based on model
context_budget:
  max_tokens: 120000
  reserve_for_output: 8000
  warning_threshold: 0.8

# ──────────────────────────────────────────────
# Tool Permissions
# ──────────────────────────────────────────────
tools:
  allow:
    - "read_file"
    - "write_file"
    - "patch"
    - "search_files"
    - "terminal"
    - "web_search"
    - "web_extract"
    - "skill_view"
    - "skill_manage"
    - "memory"
    - "delegate_task"
    - "todo_list"
    - "browser_exec"
    - "browser_vault_list"
    - "browser_vault_fill"
  deny: []
  # Require confirmation for destructive operations
  confirm_destructive: true

# ──────────────────────────────────────────────
# Skill Configuration
# ──────────────────────────────────────────────
skills:
  # Core skills (always loaded)
  core:
    - orchestrator
    - ponytail
    - executive-agent-mode
    - antislop

  # Stack-specific skills
  stack:
    go:
      - go-railway-backend
      - go-http-service-performance
    node:
      - setup-ts-deep-modules
    laravel:
      # Add Laravel-specific skills here
    python:
      # Add Python-specific skills here

  # Project skills (loaded on demand) — replace with generic examples or your own
  project:
    - code-review
    - test-driven-development
    - systematic-debugging

  # Path to custom skills (relative to profile root)
  custom_paths:
    - "skills"

# ──────────────────────────────────────────────
# MCP Server Registry
# ──────────────────────────────────────────────
mcp:
  enabled:
    - github
    - jira
    - postgres
    - cloudflare
    - doris
    - n8n
    - ssh

  servers:
    github:
      command: "mcp-github"
      env:
        GITHUB_TOKEN: "${GITHUB_TOKEN}"
    jira:
      command: "mcp-jira"
      env:
        JIRA_URL: "${JIRA_URL}"
        JIRA_EMAIL: "${JIRA_EMAIL}"
        JIRA_TOKEN: "${JIRA_TOKEN}"
    postgres:
      command: "mcp-postgres"
      env:
        POSTGRES_DSN: "${POSTGRES_DSN}"
    cloudflare:
      command: "mcp-cloudflare"
      env:
        CF_API_TOKEN: "${CF_API_TOKEN}"
        CF_ACCOUNT_ID: "${CF_ACCOUNT_ID}"
    doris:
      command: "mcp-doris"
      env:
        DORIS_URL: "${DORIS_URL}"
        DORIS_USER: "${DORIS_USER}"
        DORIS_PASSWORD: "${DORIS_PASSWORD}"
    n8n:
      command: "mcp-n8n"
      env:
        N8N_URL: "${N8N_URL}"
        N8N_API_KEY: "${N8N_API_KEY}"
    ssh:
      command: "mcp-ssh"
      env:
        SSH_CONFIG: "${HOME}/.ssh/config"

# ──────────────────────────────────────────────
# Profile Settings
# ──────────────────────────────────────────────
profile:
  name: "{{.ProfileName}}"
  home: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}"
  data_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/data"
  cache_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/cache"
  memory_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/memory"
  skills_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/skills"
  plugins_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/plugins"
  cron_dir: "{{.HomeDir}}/.hermes/profiles/{{.ProfileName}}/cron"

# ──────────────────────────────────────────────
# Server Aliases (for deploy commands)
# ──────────────────────────────────────────────
# Generic placeholders — replace with your own servers.
servers:
  staging:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"
  data:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"
  edge:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"
  gateway:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"
  worker-1:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"
  worker-2:
    host: "your-server.example.com"
    user: "your-user"
    alias: "generic"

# ──────────────────────────────────────────────
# Hooks
# ──────────────────────────────────────────────
hooks:
  pre_commit:
    - "go fmt ./..."
    - "go vet ./..."
    - "golangci-lint run"
    - "go test ./..."
  pre_push:
    - "go build ./..."
    - "go test ./..."
  post_merge:
    - "./scripts/deploy-check.sh"

# ──────────────────────────────────────────────
# Git Configuration
# ──────────────────────────────────────────────
git:
  user:
    name: "Your Name"
    email: "you@example.com"
  # Signing key (optional)
  # signing_key: "~/.ssh/git-signing-key"

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────
features:
  kanban: true
  swarm: true
  memory_sync: true
  auto_update_skills: false
  telemetry: false